+        let cap = sui::test_scenario::take_from_sender<AdminCap>(&scenario);
+        let config = sui::test_scenario::take_shared<Configuration>(&scenario);
+        assert!(config.admin == old_payout, 99);
+        finish_security_tests(scenario, cap, config);
+    }
